{
  "name": "@satinhq/lint",
  "version": "0.1.2",
  "type": "module",
  "description": "Fidelity lint preset for Satin apps: bans the web idioms that break the native illusion.",
  "exports": {
    "./oxlint": "./oxlint.json",
    "./check-fidelity": "./scripts/check-fidelity.mjs",
    "./rule-manifest": "./src/rules.mjs"
  },
  "scripts": {
    "typecheck": "true",
    "lint": "oxlint scripts src tests",
    "test": "node --test"
  },
  "dependencies": {
    "typescript": "7.0.2",
    "oxc-parser": "0.153.0"
  },
  "devDependencies": {
    "oxlint": "^1.79.0"
  },
  "license": "MIT",
  "files": [
    "oxlint.json",
    "scripts",
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "latest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/satinhq/satin.git",
    "directory": "packages/lint"
  },
  "homepage": "https://satin.build",
  "bin": {
    "satin-lint": "./scripts/check-fidelity.mjs"
  }
}
